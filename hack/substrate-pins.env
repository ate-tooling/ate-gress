# The Substrate that CI treats as known-good: the nightly end-to-end workflow
# runs against it next to the tip of Substrate's main branch, so that a change
# in Substrate shows as "latest red, pinned green". Sourced by
# hack/substrate-kind-up.sh and read by .github/workflows/e2e-substrate.yaml.
#
# Nothing updates these automatically. Bump them together when the
# agent-substrate-operator releases with a newer embedded Substrate
# (docs/ci.md, "Moving the Substrate pin").

# An agent-substrate/substrate release, and the commit its tag names.
SUBSTRATE_VERSION=v1.0.0
SUBSTRATE_COMMIT=b34fbee742906494b5eb4f1f36987176bf8770a4
# Where that release's images are published. Upstream publishes none; these
# are the agent-substrate-operator project's rebuilds of the release tag.
SUBSTRATE_IMAGE_REPO=ghcr.io/ate-tooling/substrate
# The agent-substrate-operator chart version that embeds SUBSTRATE_VERSION
# (oci://ghcr.io/ate-tooling/charts/agent-substrate-operator).
OPERATOR_VERSION=0.3.1
